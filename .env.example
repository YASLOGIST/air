# No runtime environment variables are required for the deployed site.
# Vercel Analytics activates only when deployed on Vercel.
#
# Optional: when running the sibling YASLOGIST apps locally, override their
# browser-facing links explicitly. Without these, safe public origins are used.
# VITE_HUB_URL=https://yaslogist.com
# VITE_LAND_URL=https://land.yaslogist.com
# VITE_OCEAN_URL=https://ocean.yaslogist.com
# VITE_AIR_URL=https://air.yaslogist.com
